///|
/// The bytes `prescan_mutations` puts in.
let prescan_alphabet : Bytes = b"<>/=\x22'-!?; \x09\x0A\x0C\x0D\x0B\x00Aa\xA0"

///|
/// The encodings in prescan_seeds, "a" for the first.
let prescan_names : Array[String] = [
  "windows-1252", "ISO-8859-2", "UTF-8", "EUC-JP", "windows-1251", "windows-1253",
  "UTF-16LE", "UTF-16BE", "replacement", "KOI8-R", "macintosh", "EUC-KR", "Shift_JIS",
  "GBK", "Big5", "KOI8-U", "gb18030", "IBM866", "ISO-8859-15", "ISO-8859-5", "x-user-defined",
]

